PORT=4310
DATA_DIR=.local/data
# Absolute mounted paths; keep category/name stable when replacing a disk.
# MEDIA_SOURCES=LOCAL:Library=/absolute/path/to/media;LOCAL:Archive=/absolute/path/to/archive
MEDIA_ROOT=media
SCAN_ON_START=true
AMW_LAN_MODE=false
AMW_LAN_AUTH=true
AMW_AGENT_ENABLED=false
METADATA_AUTO_ENRICH=false
SUBTITLE_AUTO_TRANSLATE_FAVORITES=false
# Optional existing services, disabled until configured:
# METADATA_SERVER_URL=http://127.0.0.1:8080
# Optional: manage a locally installed MetaTube process (native host only).
# METADATA_MANAGE_METATUBE=true
# METADATA_METATUBE_COMMAND=/absolute/path/to/metatube-server
# METADATA_METATUBE_DB=/absolute/path/to/metatube.db
# METADATA_FALLBACK_SERVER_URL=http://127.0.0.1:8081
# AMW_AGENT_OLLAMA_URL=http://127.0.0.1:11435
