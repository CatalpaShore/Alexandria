{
  "name": "alexandria-media-wall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "description": "18+ self-hosted personal media library with an isolated non-adult public demo.",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "node scripts/start-vite.mjs",
    "dev:ingestion-worker": "tsx watch server/src/ingestion-worker.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:mobile": "AMW_LAN_MODE=true concurrently -k \"PORT=3001 SCAN_ON_START=false npm run dev:server\" \"VITE_API_TARGET=http://127.0.0.1:3001 npm run dev:client\"",
    "scan": "tsx server/src/cli-scan.ts",
    "storage:check": "tsx server/src/cli-storage-check.ts",
    "agent:storage:init": "node scripts/initialize-external-ai.mjs",
    "agent:runtime:ensure": "node scripts/ensure-external-ai-runtime.mjs",
    "agent:runtime:start": "node scripts/start-external-ai-runtime.mjs",
    "agent:runtime:install": "node scripts/install-external-ai-launch-agent.mjs",
    "agent:model:migrate": "node scripts/migrate-ollama-model-to-external.mjs",
    "agent:model:install:qwen3.8-ridge": "node scripts/install-qwen3.8-ridge-model.mjs",
    "agent:model:install:ornith1.5": "node scripts/install-ornith-1.5-model.mjs",
    "metadata:backfill": "tsx server/src/cli-metadata-backfill.ts",
    "metadata:reprocess-quality": "node scripts/reprocess-metadata-quality.mjs",
    "metadata:seed": "node scripts/export-metadata-seed.mjs",
    "ingestion:seed": "node scripts/export-ingestion-history-seed.mjs",
    "ingestion:rollback-misclassified": "tsx scripts/rollback-ingestion-misclassifications.ts",
    "metadata:translate": "node scripts/translate-metadata.mjs",
    "metadata:translate-english-titles": "TRANSLATE_MODE=english-title-repair node scripts/translate-metadata.mjs",
    "metadata:improve-translations": "node scripts/improve-metadata-translations.mjs",
    "actors:normalize": "node scripts/repair-actor-aliases.mjs",
    "actors:enrich": "tsx scripts/enrich-actor-profiles.ts",
    "actors:enrich:official": "tsx scripts/enrich-official-actor-profiles.ts",
    "actors:profiles:normalize": "tsx scripts/normalize-actor-profile-data.ts",
    "actors:profiles:dedupe": "tsx scripts/dedupe-actor-profiles.ts",
    "topics:enrich:official": "tsx scripts/enrich-official-topic-profiles.ts",
    "series:enrich:product-bridges": "tsx scripts/enrich-series-profiles-from-product-bridges.ts",
    "entities:enrich": "tsx scripts/enrich-public-entity-profiles.ts",
    "entities:images:backfill": "tsx scripts/backfill-entity-profile-image-attributions.ts",
    "entities:images:cache": "tsx scripts/cache-entity-profile-images.ts",
    "entities:names:localize": "tsx scripts/localize-entity-profile-names.ts",
    "entities:audit": "tsx scripts/audit-entity-profiles.ts",
    "covers:prefetch": "node scripts/prefetch-cover-cache.mjs",
    "covers:repair": "node scripts/repair-cover-metadata.mjs",
    "covers:seed": "node scripts/sync-cover-seed.mjs",
    "changelog:generate": "node scripts/generate-changelog.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:server && vite build",
    "start": "node dist/server/index.js",
    "start:webview": "node dist/server/discoveryGateway.js",
    "start:ingestion-worker": "node dist/server/ingestion-worker.js",
    "start:local": "npm run start",
    "service:install": "bash scripts/alexandria-service.sh install",
    "service:docker:start": "node scripts/start-docker-service.mjs",
    "service:start": "bash scripts/alexandria-service.sh start",
    "service:stop": "bash scripts/alexandria-service.sh stop",
    "service:restart": "bash scripts/alexandria-service.sh restart",
    "service:deploy": "bash scripts/alexandria-service.sh deploy",
    "service:status": "bash scripts/alexandria-service.sh status",
    "service:logs": "bash scripts/alexandria-service.sh logs",
    "service:uninstall": "bash scripts/alexandria-service.sh uninstall",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "lint": "eslint .",
    "smoke": "node scripts/smoke-check.mjs",
    "test:product-api": "node scripts/product-api-check.mjs",
    "test:sidecars": "node scripts/sidecar-scan-check.mjs",
    "test:asset-backup": "tsx scripts/asset-backup-check.mjs",
    "test:subtitle-worker": "tsx scripts/subtitle-worker-check.mjs",
    "test:subtitle-translation-e2e": "tsx scripts/subtitle-translation-e2e-check.mjs",
    "test:storyboard-worker": "tsx scripts/storyboard-worker-check.mjs",
    "test:content-preview": "tsx scripts/content-preview-worker-check.mjs",
    "test:content-preview-scheduler": "tsx scripts/content-preview-scheduler-check.mjs",
    "test:motion": "node scripts/motion-system-check.mjs",
    "trial:content-preview": "tsx scripts/content-preview-trial.mjs",
    "backfill:content-preview": "tsx scripts/content-preview-backfill.mjs",
    "audit:content-preview": "tsx scripts/content-preview-audit.mjs",
    "audit:subtitle-translations": "node scripts/audit-subtitle-translations.mjs",
    "test:platform-v2": "node scripts/platform-v2-api-check.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:ingestion": "pnpm run build && node scripts/ingestion-check.mjs",
    "docker:build:amd64": "./scripts/build-amd64-image.sh",
    "docker:build:worker": "node scripts/build-native-media-worker.mjs",
    "docker:build:webview:amd64": "./scripts/build-amd64-webview-image.sh",
    "demo": "node scripts/create-demo.mjs",
    "release:check": "node scripts/check-release.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "demo:start": "node scripts/start-demo.mjs",
    "demo:prepare": "node scripts/create-demo.mjs --public",
    "example:adult-metadata": "node scripts/create-adult-metadata-example.mjs",
    "privacy:check": "node scripts/check-release.mjs --worktree",
    "privacy:history": "node scripts/check-release-history.mjs",
    "setup:library": "node scripts/setup-library.mjs",
    "doctor": "node scripts/doctor.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "demo:online:build": "pnpm build && node scripts/build-online-demo.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.23",
    "@tanstack/react-virtual": "^3.14.5",
    "antd": "6.5.0",
    "better-sqlite3": "^11.1.2",
    "compression": "^1.8.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "fast-xml-parser": "5.11.2",
    "gsap": "^3.15.0",
    "helmet": "^7.1.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
